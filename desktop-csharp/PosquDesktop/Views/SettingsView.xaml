<UserControl x:Class="PosquDesktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="0,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Profil &amp; toko" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Informasi akun yang sedang digunakan." Style="{StaticResource MutedText}"
                               Margin="0,3,0,14" />

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding TenantName}" FontSize="16" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="5" Padding="8,3">
                                    <TextBlock Text="{Binding PlanLabel, StringFormat=Paket {0}}"
                                               Foreground="{StaticResource PrimaryBrush}" FontSize="10"
                                               FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding SessionInfo}" Style="{StaticResource MutedText}"
                                           Margin="10,2,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nama" Style="{StaticResource MutedText}" />
                        <TextBlock Grid.Column="1" Text="{Binding UserName}" FontWeight="SemiBold" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Email" Style="{StaticResource MutedText}" />
                        <TextBlock Grid.Column="1" Text="{Binding UserEmail}" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Peran" Style="{StaticResource MutedText}" />
                        <TextBlock Grid.Column="1" Text="{Binding UserRole}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="14,0,0,0">
                <StackPanel>
                    <TextBlock Text="Koneksi server" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Alamat API yang dipakai aplikasi desktop." Style="{StaticResource MutedText}"
                               Margin="0,3,0,14" />
                    <TextBox x:Name="ApiUrlBox" Style="{StaticResource InputTextBox}"
                             Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Mengubah alamat server akan mengakhiri sesi dan meminta login ulang."
                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Simpan Pengaturan"
                                Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Keamanan" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Kredensial disimpan terenkripsi di perangkat ini." Style="{StaticResource MutedText}"
                               Margin="0,3,0,14" />
                    <CheckBox Content="Ingat email &amp; password di perangkat ini"
                              IsChecked="{Binding RememberPassword}" />
                    <Button Style="{StaticResource DangerButton}" Content="Keluar dari Akun" Margin="0,18,0,0"
                            HorizontalAlignment="Left" Command="{Binding LogoutCommand}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="14,14,0,0">
                <StackPanel>
                    <TextBlock Text="Tentang aplikasi" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="POSQU Pro Desktop Edition" Style="{StaticResource MutedText}" Margin="0,3,0,14" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Versi" Style="{StaticResource MutedText}" />
                        <TextBlock Grid.Column="1" Text="{Binding AppVersion}" />
                    </Grid>
                    <TextBlock Text="Folder data" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding DataFolder}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="8" Padding="12"
                            Margin="0,14,0,0">
                        <TextBlock Text="Mode offline: transaksi tetap tersimpan di perangkat lalu dikirim otomatis saat koneksi kembali."
                                   FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource PrimaryBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardBorder}" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Printer" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Printer yang terpasang di Windows. Kosongkan untuk memilih printer setiap kali mencetak."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,8" />

                        <ComboBox x:Name="PrinterCombo" Style="{StaticResource InputCombo}"
                                  IsEditable="True" IsTextSearchEnabled="False"
                                  ItemsSource="{Binding AvailablePrinters}"
                                  Text="{Binding PrinterName, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Contoh: EPSON TM-T82 Receipt" />
                        <TextBlock Text="{Binding StatusPrinter}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />

                        <Button x:Name="RefreshPrintersButton" Style="{StaticResource SecondaryButton}"
                                Content="Muat daftar printer" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Command="{Binding RefreshPrintersCommand}" />

                        <TextBlock Text="Ukuran kertas" Style="{StaticResource SectionTitle}" FontSize="13"
                                   Margin="0,20,0,3" />
                        <TextBlock Text="Lebar kertas thermal yang dipakai untuk struk."
                                   Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                        <ComboBox x:Name="PaperSizeCombo" Style="{StaticResource InputCombo}" Width="220"
                                  HorizontalAlignment="Left" SelectedValuePath="Tag"
                                  SelectedValue="{Binding PaperSize, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="80 mm (standar)" Tag="80mm" />
                            <ComboBoxItem Content="58 mm (thermal kecil)" Tag="58mm" />
                        </ComboBox>

                        <Button x:Name="TestPrinterButton" Style="{StaticResource SecondaryButton}" Content="Tes Printer"
                                Margin="0,20,0,0" HorizontalAlignment="Left"
                                Command="{Binding TestPrinterCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Format struk" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="Judul atas struk" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
                        <TextBox x:Name="HeaderTitleBox" Style="{StaticResource InputTextBox}"
                                 Text="{Binding ReceiptHeaderTitle, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Kosongkan untuk memakai nama toko." />

                        <TextBlock Text="Sub-judul (alamat / telp)" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
                        <TextBox x:Name="HeaderSubtitleBox" Style="{StaticResource InputTextBox}"
                                 Text="{Binding ReceiptHeaderSubtitle, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Catatan kaki struk" Style="{StaticResource MutedText}" Margin="0,10,0,4" />
                        <TextBox x:Name="FooterNoteBox" Style="{StaticResource InputTextBox}"
                                 Text="{Binding ReceiptFooterNote, UpdateSourceTrigger=PropertyChanged}" />

                        <StackPanel Margin="0,14,0,0">
                            <CheckBox x:Name="ShowSkuBox" Content="Tampilkan SKU" IsChecked="{Binding ShowSku}" />
                            <CheckBox x:Name="ShowDiscountBox" Content="Tampilkan diskon" Margin="0,8,0,0"
                                      IsChecked="{Binding ShowDiscount}" />
                            <CheckBox x:Name="ShowTaxBox" Content="Tampilkan pajak" Margin="0,8,0,0"
                                      IsChecked="{Binding ShowTax}" />
                            <CheckBox x:Name="ShowPolicyBox" Content="Tampilkan ketentuan pengembalian"
                                      Margin="0,8,0,0" IsChecked="{Binding ShowPolicyLine}" />
                        </StackPanel>

                        <TextBlock Text="Transaksi" Style="{StaticResource SectionTitle}" FontSize="13"
                                   Margin="0,20,0,8" />
                        <CheckBox x:Name="AutoPrintBox" Content="Cetak struk otomatis setelah pembayaran"
                                  IsChecked="{Binding AutoPrintAfterPayment}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
