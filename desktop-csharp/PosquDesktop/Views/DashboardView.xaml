<UserControl x:Class="PosquDesktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeroGradientBrush}" CornerRadius="16" Padding="24,20">
            <Border.Effect>
                <DropShadowEffect Color="#3730A3" BlurRadius="28" ShadowDepth="5" Opacity="0.22" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#22FFFFFF" CornerRadius="7" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock Text="RINGKASAN HARI INI" Foreground="White" FontSize="9"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding UserGreeting}" FontSize="22" FontWeight="SemiBold"
                               Foreground="White" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding StoreName, StringFormat=Ringkasan operasional {0} hari ini.}"
                               Foreground="#C7D2FE" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Background="#1AFFFFFF"
                            BorderBrush="#33FFFFFF" Foreground="White"
                            Command="{Binding GoToCommand}" CommandParameter="products" Content="Kelola Produk" />
                    <Button Style="{StaticResource SecondaryButton}" Background="White" Foreground="#4338CA"
                            BorderBrush="White" FontWeight="SemiBold"
                            Command="{Binding GoToCommand}" CommandParameter="pos" Content="Transaksi Baru" />
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,14,0,0">
            <Border Style="{StaticResource MetricCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource PrimarySoftBrush}">
                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Penjualan hari ini" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="9,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding TodaySalesText}" FontSize="23" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0" />
                    <TextBlock Grid.Row="2" Text="Total nilai transaksi" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </Grid>
            </Border>
            <Border Style="{StaticResource MetricCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource SuccessSoftBrush}">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{StaticResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Jumlah transaksi" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="9,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding TodayTransactions}" FontSize="23" FontWeight="Bold"
                               Margin="0,10,0,0" />
                    <TextBlock Grid.Row="2" Text="Transaksi berhasil" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </Grid>
            </Border>
            <Border Style="{StaticResource MetricCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Rata-rata transaksi" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="9,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding AverageSaleText}" FontSize="23" FontWeight="Bold"
                               Margin="0,10,0,0" />
                    <TextBlock Grid.Row="2" Text="Nilai keranjang rata-rata" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </Grid>
            </Border>
            <Border Style="{StaticResource MetricCard}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource WarningSoftBrush}">
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                       Foreground="{StaticResource WarningBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Stok menipis" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="9,0,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding LowStockCount}" FontSize="23" FontWeight="Bold" Margin="0,10,0,0"
                               Foreground="{StaticResource WarningBrush}" />
                    <TextBlock Grid.Row="2" Text="{Binding ProductCount, StringFormat=Dari {0} produk aktif}"
                               Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </Grid>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="18,16,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Transaksi terbaru" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding OpenShiftLabel}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Lihat semua"
                                Command="{Binding GoToCommand}" CommandParameter="sales" FontSize="12" />
                    </Grid>
                    <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="10"
                            Margin="18,0,18,12" Padding="14,10,14,8">
                        <StackPanel>
                            <TextBlock Text="Penjualan 7 hari terakhir" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding Weekly}" Margin="0,8,0,0" Height="100">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Bottom" Margin="3,0">
                                            <TextBlock Text="{Binding TotalText}" FontSize="8"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="64" />
                                            <Border Height="{Binding BarHeight}" MinHeight="3" CornerRadius="4,4,0,0"
                                                    Margin="0,3,0,0" Background="{StaticResource PrimaryGradientBrush}" />
                                            <TextBlock Text="{Binding DateLabel}" FontSize="9"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding RecentSales}" BorderThickness="0"
                              Background="Transparent" Margin="0,0,0,6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNo}" Width="*" />
                            <DataGridTextColumn Header="Waktu" Binding="{Binding CreatedAt, StringFormat=dd/MM HH:mm}" Width="90" />
                            <DataGridTextColumn Header="Metode" Binding="{Binding PaymentLabel}" Width="90" />
                            <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=Rp {0:N0}}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="14,0,0,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="18,16,18,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Perlu restock" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Produk dengan stok di bawah minimum" Style="{StaticResource MutedText}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Kelola"
                                Command="{Binding GoToCommand}" CommandParameter="products" FontSize="12" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,0,14,14">
                            <ItemsControl ItemsSource="{Binding LowStockProducts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8"
                                                Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Sku, StringFormat=SKU {0}}"
                                                               Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Stock, StringFormat={}{0:N0}}"
                                                               FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding MinStock, StringFormat=min {0:N0}}"
                                                               Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Semua stok dalam kondisi aman."
                                       TextAlignment="Center" Margin="0,20,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LowStockCount}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

