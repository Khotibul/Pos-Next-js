<UserControl x:Class="PosquDesktop.Views.ShiftsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource PrimarySoftBrush}">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Shift kasir" Style="{StaticResource SectionTitle}" />
                            <Border CornerRadius="5" Padding="7,2" Margin="8,1,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOpenShift}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CurrentShiftLabel}" FontSize="10" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOpenShift}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Kelola uang kas awal, penutupan, dan selisih kas."
                                   Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding OpenCount, StringFormat={}{0} shift terbuka}" FontSize="12"
                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ClosedCount, StringFormat={}{0} shift selesai}"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="Buka Shift"
                            Command="{Binding OpenShiftCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="0">
            <DataGrid ItemsSource="{Binding Shifts}" SelectedItem="{Binding SelectedShift}"
                      BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Dibuka" Binding="{Binding OpenedLabel}" Width="130" />
                    <DataGridTextColumn Header="Ditutup" Binding="{Binding ClosedLabel}" Width="130" />
                    <DataGridTextColumn Header="Kas awal" Binding="{Binding OpeningCash, StringFormat=Rp {0:N0}}" Width="110" />
                    <DataGridTextColumn Header="Penjualan" Binding="{Binding TotalSales, StringFormat=Rp {0:N0}}" Width="110" />
                    <DataGridTextColumn Header="Kas sistem" Binding="{Binding CashSystem, StringFormat=Rp {0:N0}}" Width="110" />
                    <DataGridTextColumn Header="Kas dihitung" Binding="{Binding CashCounted, StringFormat=Rp {0:N0}}" Width="110" />
                    <DataGridTextColumn Header="Selisih" Binding="{Binding CashDifference, StringFormat=Rp {0:N0}}" Width="100" />
                    <DataGridTextColumn Header="Transaksi" Binding="{Binding TransactionCount}" Width="80" />
                    <DataGridTemplateColumn Header="Status" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="5" Padding="7,3" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SmallButton}" Content="Tutup"
                                        IsEnabled="{Binding IsOpen}"
                                        Command="{Binding DataContext.CloseShiftCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
