<UserControl x:Class="PosquDesktop.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Total supplier" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveCount}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Supplier aktif" Style="{StaticResource MutedText}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Tambah Supplier"
                        Command="{Binding AddCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,12,0,0">
            <TextBox Style="{StaticResource InputTextBox}" Width="320" HorizontalAlignment="Left"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Cari nama supplier atau kontak" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                          BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama supplier" Binding="{Binding Name}" Width="1.4*" />
                        <DataGridTextColumn Header="Kontak" Binding="{Binding ContactPerson}" Width="130" />
                        <DataGridTextColumn Header="Telepon" Binding="{Binding Phone}" Width="130" />
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.2*" />
                        <DataGridTextColumn Header="Kota" Binding="{Binding City}" Width="110" />
                        <DataGridTextColumn Header="NPWP" Binding="{Binding Npwp}" Width="130" />
                        <DataGridTemplateColumn Header="" Width="132">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource SmallButton}" Content="Ubah"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource SmallButton}" Content="Hapus" Margin="6,0,0,0"
                                                Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Belum ada supplier." Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
