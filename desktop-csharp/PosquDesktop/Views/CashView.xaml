<UserControl x:Class="PosquDesktop.Views.CashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <UniformGrid Columns="3">
                    <StackPanel>
                        <TextBlock Text="Kas masuk" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TotalInText}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Kas keluar" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TotalOutText}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Saldo kas" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding BalanceText}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </UniformGrid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Content="Catat Kas" Command="{Binding AddCommand}" />
                    <TextBlock Text="{Binding ShiftLabel}" Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Tampilkan" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <ComboBox Style="{StaticResource InputCombo}" Width="160" ItemsSource="{Binding TypeFilters}"
                          SelectedItem="{Binding TypeFilter}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Transactions}" BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tanggal" Binding="{Binding TransactionDate, StringFormat=dd/MM/yyyy HH:mm}"
                                            Width="140" />
                        <DataGridTemplateColumn Header="Jenis" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="5" Padding="7,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="IN">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="IN">
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="150" />
                        <DataGridTextColumn Header="Keterangan" Binding="{Binding Description}" Width="*" />
                        <DataGridTextColumn Header="Jumlah" Binding="{Binding Amount, StringFormat=Rp {0:N0}}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Belum ada transaksi kas." Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
