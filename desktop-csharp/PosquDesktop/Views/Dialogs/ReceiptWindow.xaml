<Window x:Class="PosquDesktop.Views.Dialogs.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Struk Transaksi" Width="420" Height="740" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="10" Padding="22,24"
                    MaxWidth="{Binding ReceiptMaxWidth}" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="16" FontWeight="Bold" TextAlignment="Center" />
                    <TextBlock Text="{Binding HeaderSubtitle}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center"
                               Margin="0,3,0,0"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Struk Penjualan" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextAlignment="Center" Margin="0,3,0,0" />
                    <TextBlock Text="--------------------------------" FontFamily="Consolas" TextAlignment="Center"
                               Foreground="{StaticResource BorderStrongBrush}" Margin="0,12,0,10" />

                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="No. Invoice" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding InvoiceNo}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Tanggal" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding DateLabel}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Kasir" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding CashierName}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,3" Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Pelanggan" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding CustomerLabel}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock Text="--------------------------------" FontFamily="Consolas" TextAlignment="Center"
                               Foreground="{StaticResource BorderStrongBrush}" Margin="0,10,0,8" />

                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,7">
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <Grid>
                                        <TextBlock Text="{Binding QtyPrice}" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding TotalText}" FontSize="11" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding SkuLabel}" FontSize="9"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"
                                               Visibility="{Binding ShowSkuLine, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="--------------------------------" FontFamily="Consolas" TextAlignment="Center"
                               Foreground="{StaticResource BorderStrongBrush}" Margin="0,4,0,8" />

                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Subtotal" FontSize="11" />
                        <TextBlock Text="{Binding SubtotalText}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,3" Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Diskon" FontSize="11" />
                        <TextBlock Text="{Binding DiscountText}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,3" Visibility="{Binding HasTax, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Pajak" FontSize="11" />
                        <TextBlock Text="{Binding TaxText}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,4,0,6">
                        <TextBlock Text="TOTAL" FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="{Binding TotalText}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Pembayaran" FontSize="11" />
                        <TextBlock Text="{Binding PaymentLabel}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Diterima" FontSize="11" />
                        <TextBlock Text="{Binding PaidText}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,3">
                        <TextBlock Text="Kembalian" FontSize="11" />
                        <TextBlock Text="{Binding ChangeText}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,3" Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Jatuh tempo" FontSize="11" />
                        <TextBlock Text="{Binding DueDateText}" FontSize="11" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock Text="{Binding Note}" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"
                               Visibility="{Binding Note, Converter={StaticResource StringToVisibility}}" />

                    <TextBlock Text="--------------------------------" FontFamily="Consolas" TextAlignment="Center"
                               Foreground="{StaticResource BorderStrongBrush}" Margin="0,12,0,8" />
                    <TextBlock Text="{Binding FooterNote}" FontSize="11" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="Barang yang sudah dibeli tidak dapat ditukar" FontSize="9"
                               Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding ShowPolicyLine, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource SecondaryButton}" Content="Tutup" Click="Close_Click" />
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Cetak Struk"
                    Margin="8,0,0,0" Click="Print_Click" />
        </Grid>
    </Grid>
</Window>
