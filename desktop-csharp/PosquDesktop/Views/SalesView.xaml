<UserControl x:Class="PosquDesktop.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Dari tanggal" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <DatePicker Width="140" SelectedDate="{Binding StartDate}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Sampai tanggal" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <DatePicker Width="140" SelectedDate="{Binding EndDate}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Cari" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource InputTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Cari nomor invoice atau catatan" />
                </StackPanel>
                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Terapkan"
                        VerticalAlignment="Bottom" Command="{Binding ApplyFiltersCommand}" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,12,0,0">
            <Border Style="{StaticResource MetricCard}" Padding="14">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="Transaksi" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TransactionCount}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Total penjualan" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding TotalSalesText}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Rata-rata" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding AverageSaleText}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="0">
                <DataGrid ItemsSource="{Binding Sales}" SelectedItem="{Binding SelectedSale}"
                          BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice" Binding="{Binding InvoiceNo}" Width="*" />
                        <DataGridTextColumn Header="Tanggal" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="130" />
                        <DataGridTextColumn Header="Pelanggan" Binding="{Binding CustomerName}" Width="140" />
                        <DataGridTextColumn Header="Metode" Binding="{Binding PaymentLabel}" Width="90" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=Rp {0:N0}}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="14,0,0,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,14"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedSale.InvoiceNo}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedSale.CreatedAt, StringFormat=dd/MM/yyyy HH:mm}"
                                       Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                            <TextBlock Text="{Binding SelectedSale.CustomerName, StringFormat=Pelanggan: {0}}"
                                       Style="{StaticResource MutedText}" Margin="0,3,0,0"
                                       Visibility="{Binding SelectedSale.CustomerName, Converter={StaticResource StringToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,10,12,0">
                            <ItemsControl ItemsSource="{Binding DetailItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Qty, StringFormat={}{0:N0} x}"
                                                           Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat=Rp {0:N0}}"
                                                       FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                   Foreground="{StaticResource BorderStrongBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Pilih transaksi" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="18,12"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Subtotal" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding SelectedSale.Subtotal, StringFormat=Rp {0:N0}}"
                                           HorizontalAlignment="Right" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Diskon" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding SelectedSale.Discount, StringFormat=Rp {0:N0}}"
                                           HorizontalAlignment="Right" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Pajak" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding SelectedSale.Tax, StringFormat=Rp {0:N0}}"
                                           HorizontalAlignment="Right" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,3,0,10">
                                <TextBlock Text="Total" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedSale.Total, StringFormat=Rp {0:N0}}"
                                           HorizontalAlignment="Right" FontWeight="Bold" FontSize="16"
                                           Foreground="{StaticResource PrimaryBrush}" />
                            </Grid>
                            <Grid Margin="0,0,0,5">
                                <TextBlock Text="Pembayaran" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding SelectedSale.PaymentLabel}" HorizontalAlignment="Right" FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Diterima" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding SelectedSale.PaidAmount, StringFormat=Rp {0:N0}}"
                                           HorizontalAlignment="Right" FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SecondaryButton}" Content="Lihat / Cetak Struk"
                                        Command="{Binding ShowReceiptCommand}" CommandParameter="{Binding SelectedSale}" />
                                <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="Hapus"
                                        Margin="8,0,0,0" Foreground="{StaticResource DangerBrush}"
                                        Visibility="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding SelectedSale}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
