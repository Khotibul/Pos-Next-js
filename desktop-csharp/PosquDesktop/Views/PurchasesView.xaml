<UserControl x:Class="PosquDesktop.Views.PurchasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <UniformGrid Columns="4">
                    <StackPanel>
                        <TextBlock Text="Total PO" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Draft" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding DraftCount}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Dipesan" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding OrderedCount}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Nilai pembelian" Style="{StaticResource MutedText}" />
                        <TextBlock Text="{Binding TotalValueText}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                    </StackPanel>
                </UniformGrid>
                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Buat PO"
                        Command="{Binding AddCommand}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource InputTextBox}" Width="300" VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Cari no. PO, supplier, atau catatan" />
                <TextBlock Text="Status" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                           Margin="16,0,8,0" />
                <ComboBox Style="{StaticResource InputCombo}" Width="150" ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding StatusFilter}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="8" Padding="12,9">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12" />
            </Border>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                          BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No. PO" Binding="{Binding OrderNo}" Width="145">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName, TargetNullValue=-}" Width="1.3*" />
                        <DataGridTemplateColumn Header="Status" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="5" Padding="7,3" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="ORDERED">
                                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="RECEIVED">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="CANCELED">
                                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Item" Binding="{Binding ItemCount}" Width="60" />
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=Rp {0:N0}}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tanggal" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="105" />
                        <DataGridTextColumn Header="Catatan" Binding="{Binding Notes}" Width="*" />
                        <DataGridTemplateColumn Header="" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SmallButton}" Content="Ubah"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="Belum ada purchase order." Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
