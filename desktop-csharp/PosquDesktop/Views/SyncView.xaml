<UserControl x:Class="PosquDesktop.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Sinkronisasi data" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding TenantName}" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    <TextBlock Text="{Binding DatasetInfo}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="6" Padding="8,3"
                                Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ConnectionLabel}" Foreground="{StaticResource SuccessBrush}"
                                       FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="6" Padding="8,3"
                                Visibility="{Binding IsOnline, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="{Binding ConnectionLabel}" Foreground="{StaticResource WarningBrush}"
                                       FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="8,3" Margin="7,0,0,0">
                            <TextBlock Text="{Binding QueueLabel}" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding ConnectionHint}" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                    <TextBlock Text="{Binding LastSyncLabel}" FontSize="12" Margin="0,10,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding ProgressMessage}" FontSize="12" Margin="0,4,0,0"
                               Foreground="{StaticResource PrimaryBrush}"
                               Visibility="{Binding ProgressMessage, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SyncCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Muat Ulang Data" Margin="8,0,0,0" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RetryFailedCommand}"
                            Content="Kirim Ulang Ditolak" Margin="0,8,0,0"
                            Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Produk, penjualan, shift, dan master data." Style="{StaticResource MutedText}"
                               HorizontalAlignment="Right" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Langkah sinkronisasi" Style="{StaticResource SectionTitle}" Margin="18,16,18,10" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Steps}" Margin="14,0,14,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8"
                                        Padding="14,11" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}"
                                                       Margin="0,3,0,0"
                                                       Visibility="{Binding Detail, Converter={StaticResource StringToVisibility}}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Selesai">
                                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Gagal">
                                                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Berjalan…">
                                                            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Selesai">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Gagal">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Berjalan…">
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
