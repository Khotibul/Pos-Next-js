<UserControl x:Class="PosquDesktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorder}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Dari tanggal" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <DatePicker Width="140" SelectedDate="{Binding StartDate}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Sampai tanggal" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <DatePicker Width="140" SelectedDate="{Binding EndDate}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding RangeNote}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Tampilkan"
                        VerticalAlignment="Bottom" Command="{Binding ApplyCommand}" />
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,0">
            <Border Style="{StaticResource MetricCard}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Total penjualan" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding TotalRevenueText}" FontSize="19" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Transaksi" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding TransactionCount}" FontSize="19" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Rata-rata" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding AverageSaleText}" FontSize="19" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Item terjual" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding ItemsSoldText}" FontSize="19" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Produk terlaris" Style="{StaticResource SectionTitle}" Margin="18,16,18,8" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TopProducts}" BorderThickness="0"
                              Background="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="40" />
                            <DataGridTextColumn Header="Produk" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding QtyText}" Width="70" />
                            <DataGridTextColumn Header="Pendapatan" Binding="{Binding RevenueText}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="14,0,0,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Metode pembayaran" Style="{StaticResource SectionTitle}" Margin="18,16,18,8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Payments}" Margin="14,0,14,14">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8"
                                            Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Method}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Count, StringFormat={}{0} transaksi}"
                                                           Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalText}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="18,14,18,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Penjualan harian" Style="{StaticResource SectionTitle}" />
                    <TextBlock Grid.Column="1" Text="{Binding HasData, Converter={StaticResource BoolToVisibility}}"
                               Visibility="Collapsed" />
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Daily}" Margin="18,4,18,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="42" VerticalAlignment="Bottom" ToolTip="{Binding TotalText}">
                                    <Border Height="{Binding BarHeight}" Width="22" CornerRadius="4,4,0,0"
                                            Background="{StaticResource PrimaryBrush}" VerticalAlignment="Bottom"
                                            HorizontalAlignment="Center" />
                                    <Border Height="1" Background="{StaticResource BorderBrush}" />
                                    <TextBlock Text="{Binding DateLabel}" FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="1" Text="Belum ada penjualan pada periode ini."
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasData}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>

