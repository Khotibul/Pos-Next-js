<Window x:Class="PosquDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POSQU Pro Desktop" Icon="pack://application:,,,/app.ico"
        Width="1360" Height="840"
MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarGradientBrush}" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,24,20,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource PrimaryGradientBrush}">
                            <Border.Effect>
                                <DropShadowEffect Color="#4F46E5" BlurRadius="14" ShadowDepth="0" Opacity="0.55" />
                            </Border.Effect>
                            <Image Source="pack://application:,,,/app.ico" Width="26" Height="26"
                                   Stretch="Uniform" Margin="6" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="POSQU Pro" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Desktop Edition" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#1E293B" CornerRadius="8" Padding="10,7" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#22C55E" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding TenantName}" Foreground="#E2E8F0" FontSize="11"
                                       Margin="8,0,0,0" TextTrimming="CharacterEllipsis" Width="150" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0,12,0">
                    <ItemsControl ItemsSource="{Binding NavGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="{Binding Label}" Foreground="White"
                                               FontSize="12" FontWeight="SemiBold" Margin="12,0,0,7" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource NavButton}"
                                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Key}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="16" VerticalAlignment="Center"
                                                                   Foreground="White" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                                   VerticalAlignment="Center" FontSize="16"
                                                                   Foreground="White" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource PrimaryGradientBrush}">
                            <TextBlock Text="{Binding UserInitials}" Foreground="White" FontSize="13"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" Foreground="White" FontSize="12"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding UserRole}" Foreground="White"
                                       FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE7E8;"
                                Foreground="#94A3B8" ToolTip="Keluar"
                                Command="{Binding LogoutCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="26,20,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource SidebarGradientBrush}" CornerRadius="14" Padding="22,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitleElement" Text="{Binding CurrentTitle}"
                               Style="{StaticResource PageTitle}"
                               Foreground="White" FontSize="30" />
                    <TextBlock Text="{Binding CurrentSubtitle}" Style="{StaticResource MutedText}"
                               Foreground="#C7D2FE" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="7" Padding="9,5"
                            Margin="0,0,10,0" VerticalAlignment="Center"
                            Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{Binding ConnectionHint}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionLabel}" Foreground="{StaticResource SuccessBrush}"
                                       FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="7" Padding="9,5"
                            Margin="0,0,10,0" VerticalAlignment="Center"
                            Visibility="{Binding IsOnline, Converter={StaticResource InverseBoolToVisibility}}"
                            ToolTip="{Binding ConnectionHint}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionLabel}" Foreground="{StaticResource WarningBrush}"
                                       FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" />
                            <Border Background="{StaticResource DangerBrush}" CornerRadius="9" Padding="6,1"
                                    Margin="7,0,0,0" Visibility="{Binding HasPendingSync, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding PendingSyncCount}" Foreground="White" FontSize="9"
                                           FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding SyncNowCommand}"
                            Margin="0,0,10,0" ToolTip="{Binding ConnectionHint}"
                            Visibility="{Binding HasPendingSync, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SyncLabel}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TodayLabel}" Foreground="#E2E8F0"
                                   FontSize="12" HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                            <Border Background="{StaticResource PrimarySoftBrush}" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="{Binding PlanLabel, StringFormat=Paket {0}}"
                                           Foreground="{StaticResource PrimaryBrush}" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding TenantName}" Style="{StaticResource MutedText}"
                                       Foreground="#CBD5E1" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"
                            ToolTip="Muat ulang data halaman ini">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="Muat ulang" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="14,10"
                        Margin="0,0,0,8"
                        Visibility="{Binding ShowOfflineBanner, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="Mode Offline Aktif" Foreground="{StaticResource WarningBrush}"
                                       FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ConnectionHint}" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SyncLabel}" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Style="{StaticResource SmallButton}" Content="Sinkron sekarang"
                                    Command="{Binding SyncNowCommand}"
                                    Visibility="{Binding HasPendingSync, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="8" Padding="14,10"
                        Visibility="{Binding CurrentPage.ErrorMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding CurrentPage.ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                </Border>
                <Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="8" Padding="14,10"
                        Margin="0,8,0,0"
                        Visibility="{Binding CurrentPage.StatusMessage, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding CurrentPage.StatusMessage}" Foreground="{StaticResource SuccessBrush}"
                               FontSize="12" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Margin="0,16,0,0"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
