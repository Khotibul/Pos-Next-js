<Window x:Class="PosquDesktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POSQU Pro Desktop - Masuk"
        Width="1000" Height="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">
    <Border x:Name="RootCard" Background="{StaticResource SurfaceBrush}" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.28" Color="#0F172A" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="16,0,0,16" Background="{StaticResource HeroGradientBrush}">
                <Grid Margin="42">
                    <StackPanel VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="12" Background="#FFFFFF">
                                <TextBlock Text="P" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="#1D4ED8" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="POSQU Pro" Foreground="White" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="Desktop Edition" Foreground="#BFDBFE" FontSize="11" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Kelola toko lebih cepat dari desktop."
                                   Foreground="White" FontSize="27" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,54,0,0" LineHeight="34" />
                        <TextBlock Text="Kasir, stok, shift, dan laporan dalam satu aplikasi yang ringan."
                                   Foreground="#DBEAFE" FontSize="13" TextWrapping="Wrap"
                                   Margin="0,12,0,0" LineHeight="21" />

                        <StackPanel Margin="0,44,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#1D4ED8">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Transaksi kasir cepat dengan barcode"
                                           Foreground="#E0E7FF" FontSize="13" Margin="10,2,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#1D4ED8">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Data tersinkron dengan web dan Android"
                                           Foreground="#E0E7FF" FontSize="13" Margin="10,2,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#1D4ED8">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Mode offline dengan antrean sinkron otomatis"
                                           Foreground="#E0E7FF" FontSize="13" Margin="10,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="&#169; 2026 POSQU Pro &#183; v1.0.0" Foreground="#93C5FD" FontSize="11"
                               VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="52,28,52,40">
                <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Padding="0"
                        Click="Close_Click" ToolTip="Tutup" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,34,0,0">
                    <StackPanel>
                        <TextBlock Text="Masuk ke akun" Style="{StaticResource PageTitle}" FontSize="26" />
                        <TextBlock Text="Gunakan akun POSQU Pro yang sama seperti di web atau Android."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />

                        <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="8" Padding="12,10"
                                Margin="0,18,0,0"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                       FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="Email" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,22,0,6" />
                        <!-- TabIndex eksplisit: fokus keyboard selalu urut ke input ini -->
                        <TextBox x:Name="EmailInput" Style="{StaticResource InputTextBox}"
                                 IsTabStop="True" TabIndex="0" Focusable="True"
                                 InputMethod.IsInputMethodEnabled="False"
                                 SpellCheck.IsEnabled="False"
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,14,0,6" />
                        <PasswordBox x:Name="PasswordInput" Style="{StaticResource InputPasswordBox}"
                                     Focusable="True" TabIndex="1" IsTabStop="True"
                                     InputMethod.IsInputMethodEnabled="False"
                                     PasswordChanged="PasswordInput_PasswordChanged" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="Ingat email &amp; password" IsChecked="{Binding RememberPassword}"
                                      VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="6,2"
                                    Content="Pengaturan server" FontSize="12"
                                    Command="{Binding ToggleServerSettingsCommand}" />
                        </Grid>

                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="14"
                                Margin="0,14,0,0"
                                Visibility="{Binding ShowServerSettings, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Alamat API server" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <TextBox Style="{StaticResource InputTextBox}"
                                         Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Default: https://pos-next-js-kohl.vercel.app/api"
                                           Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="LoginButton" Margin="0,24,0,0" Height="44" TabIndex="2"
                                Click="LoginButton_Click" Command="{Binding LoginCommand}" IsDefault="True">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Content" Value="Masuk" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Content" Value="Memproses..." />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <TextBlock Text="Aplikasi desktop menggunakan koneksi internet untuk mengambil data terbaru."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,18,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>

