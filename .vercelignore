# Vercel deploy ignore - synced with .gitignore
# dependencies
node_modules/
.npm-cache/
**/.npm-cache/
src/.npm-cache/

# next.js
.next/
.next-desktop/
out/

# desktop/electron build outputs
dist-electron/
dist-desktop/
dist-desktop-build/
.desktop-userdata/

# ---------------------------------------------------------------
# LOKAL SAJA - alat bantu & hasil build di mesin developer,
# tidak perlu di-upload ke Vercel (selaras dengan .gitignore)
# ---------------------------------------------------------------
.dotnet-sdk-tmp/
tmp-dbtest/
desktop-csharp/**/bin/
desktop-csharp/**/obj/
desktop-csharp/release/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
logs/

# android/capacitor build outputs
android/.gradle/
android/**/build/
android/local.properties
android/capacitor.settings.gradle
android/app/release/
android/app/debug/
*.jks
*.keystore
android/keystore.properties
android/app/*.keystore

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# misc generated
overview.json
overview_architecture.puml
*.tsbuildinfo

# legacy UI folders (keep local only)
# Only ignore the root legacy folder, not src/components/ui.
/UI/
legacy/
src/legacy/

# vercel
.vercel/

# env - keep example
.env
.env.*.local
.env*
!.env.example

# Flutter / mobile - not part of web deploy (fix 24k file limit)
posqu-mobile-lite/.dart_tool/
posqu-mobile-lite/build/
posqu-mobile-lite/.gradle/
posqu-mobile-lite/android/.gradle/
posqu-mobile-lite/android/app/build/
posqu-mobile-lite/android/.cxx/
posqu-mobile-lite/windows/flutter/ephemeral/
posqu-mobile-lite/.flutter-plugins*
posqu-mobile-lite
posqu-pro-desktop-java/
posqu-pro-desktop-java
*.apk
*.aab
*.blockmap
public/downloads/*.apk

# AI / tooling caches
.mimocode/
.freebuff/
